{
  "name": "codali-behaviour-suite",
  "description": "Fifty live questions covering how Codali should behave, not whether its units compile. Each case carries machine-checkable expectations so the suite can be re-run after every fix without a human reading fifty answers.",
  "notes": [
    "repoFacts are asserted against the real working tree at grade time, so a renamed file fails loudly instead of silently passing.",
    "'sources' means the evidence list Codali prints; 'answer' means the prose above it."
  ],
  "cases": [
    {
      "id": "repo-01",
      "category": "repo",
      "query": "Which file defines the CodaliGatewayPlannerError class?",
      "expect": {
        "answerIncludesAny": [
          "GatewayPlanner.ts"
        ],
        "citesRepo": true,
        "noHedge": true
      }
    },
    {
      "id": "repo-02",
      "category": "repo",
      "query": "What is the value of MAX_TOOL_CALLS_PER_TASK in this repo?",
      "expect": {
        "answerIncludesAny": [
          "8"
        ],
        "noHedge": true
      }
    },
    {
      "id": "repo-03",
      "category": "repo",
      "query": "Where is truncateToolResult implemented?",
      "expect": {
        "answerIncludesAny": [
          "TruncateResult"
        ],
        "citesRepo": true,
        "noHedge": true
      }
    },
    {
      "id": "repo-04",
      "category": "repo",
      "query": "What does the RelevanceJudge do in the codali package?",
      "expect": {
        "answerIncludesAny": [
          "relevan",
          "judge",
          "search"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "repo-05",
      "category": "repo",
      "query": "List the files in packages/codali/src/gateway that deal with tools.",
      "expect": {
        "answerIncludesAny": [
          "ToolExposure",
          "ToolCapabilityCompiler",
          "ToolDescriptorSource"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "repo-06",
      "category": "repo",
      "query": "What priority does codali request from mswarm, and where is it set?",
      "expect": {
        "answerIncludesAny": [
          "-10"
        ],
        "citesRepo": true,
        "noHedge": true
      }
    },
    {
      "id": "repo-07",
      "category": "repo",
      "query": "Which class registers and executes tools in codali?",
      "expect": {
        "answerIncludesAny": [
          "ToolRegistry"
        ],
        "noHedge": true
      }
    },
    {
      "id": "repo-08",
      "category": "repo",
      "query": "How does codali authenticate with Microsoft Graph?",
      "expect": {
        "answerIncludesAny": [
          "device code",
          "device-code",
          "DeviceCodeAuth"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "repo-09",
      "category": "repo",
      "query": "What transports does the codali MCP client support?",
      "expect": {
        "answerIncludesAny": [
          "stdio",
          "http"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "repo-10",
      "category": "repo",
      "query": "Summarise what the EvidenceNormalizer is responsible for.",
      "expect": {
        "answerIncludesAny": [
          "evidence"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "repo-11",
      "category": "repo",
      "query": "What is the default tool capability name when a tool does not declare one?",
      "expect": {
        "answerIncludesAny": [
          "general"
        ],
        "noHedge": true
      }
    },
    {
      "id": "repo-12",
      "category": "repo",
      "query": "Which packages live in this monorepo?",
      "expect": {
        "answerIncludesAny": [
          "codali",
          "mswarm",
          "core"
        ],
        "citesRepo": true
      }
    },
    {
      "id": "web-01",
      "category": "web",
      "query": "What is the capital city of Australia?",
      "expect": {
        "answerIncludesAny": [
          "Canberra"
        ],
        "noRepoSources": true,
        "noHedge": true
      }
    },
    {
      "id": "web-02",
      "category": "web",
      "query": "Who wrote the novel Brave New World?",
      "expect": {
        "answerIncludesAny": [
          "Huxley"
        ],
        "noRepoSources": true,
        "noHedge": true
      }
    },
    {
      "id": "web-03",
      "category": "web",
      "query": "What is the boiling point of water at sea level in Celsius?",
      "expect": {
        "answerIncludesAny": [
          "100"
        ],
        "noRepoSources": true,
        "noHedge": true
      }
    },
    {
      "id": "web-04",
      "category": "web",
      "query": "What was the UK's nominal GDP in 2024 in pounds or dollars?",
      "expect": {
        "answerMatchesAny": [
          "\\b(2\\.[0-9]|3\\.[0-9])\\s*(trillion|tn)",
          "\\btrillion\\b"
        ],
        "noRepoSources": true,
        "citesWeb": true
      }
    },
    {
      "id": "web-05",
      "category": "web",
      "query": "Who is the current CEO of Microsoft?",
      "expect": {
        "answerIncludesAny": [
          "Nadella"
        ],
        "noRepoSources": true,
        "noHedge": true
      }
    },
    {
      "id": "web-06",
      "category": "web",
      "query": "What is the tallest mountain in the world and how high is it?",
      "expect": {
        "answerIncludesAny": [
          "Everest"
        ],
        "answerMatchesAny": [
          "8,?84[0-9]",
          "29,0[0-9][0-9]"
        ],
        "noRepoSources": true
      }
    },
    {
      "id": "web-07",
      "category": "web",
      "query": "What is the latest stable version of Node.js?",
      "expect": {
        "answerMatchesAny": [
          "\\b2[2-9]\\.",
          "\\b3[0-9]\\."
        ],
        "noRepoSources": true
      }
    },
    {
      "id": "web-08",
      "category": "web",
      "query": "When did the Eurozone last change its main refinancing interest rate, and to what?",
      "expect": {
        "answerMatchesAny": [
          "[0-9]\\s*%",
          "[0-9]\\.[0-9]+\\s*(%|percent)"
        ],
        "noRepoSources": true
      }
    },
    {
      "id": "gen-01",
      "category": "generation",
      "query": "Generate a sample welcome HTML page for a hypothetical company.",
      "expect": {
        "answerIncludesAll": [
          "<html",
          "<body"
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "gen-02",
      "category": "generation",
      "query": "Write a Python function that reverses a string.",
      "expect": {
        "answerIncludesAll": [
          "def "
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "gen-03",
      "category": "generation",
      "query": "Write a haiku about autumn rain.",
      "expect": {
        "noRepoSources": true,
        "noWebSources": true,
        "minAnswerChars": 20
      }
    },
    {
      "id": "gen-04",
      "category": "generation",
      "query": "Draft a short polite email declining a meeting invitation.",
      "expect": {
        "noRepoSources": true,
        "noWebSources": true,
        "minAnswerChars": 80
      }
    },
    {
      "id": "gen-05",
      "category": "generation",
      "query": "Write a SQL query that selects all users created in the last 30 days from a table called users.",
      "expect": {
        "answerIncludesAll": [
          "SELECT"
        ],
        "answerIncludesAny": [
          "users"
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "gen-06",
      "category": "generation",
      "query": "Write a bash one-liner that counts the number of lines in every .txt file in a directory.",
      "expect": {
        "answerIncludesAny": [
          "wc -l",
          "wc"
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "gen-07",
      "category": "generation",
      "query": "Give me a JSON object describing a book with title, author and year fields.",
      "expect": {
        "answerIncludesAll": [
          "title",
          "author",
          "year"
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "gen-08",
      "category": "generation",
      "query": "Write a CSS snippet that centers a div both horizontally and vertically.",
      "expect": {
        "answerIncludesAny": [
          "flex",
          "grid",
          "translate"
        ],
        "noRepoSources": true,
        "noWebSources": true
      }
    },
    {
      "id": "reason-01",
      "category": "reasoning",
      "query": "If a train travels 60 km in 45 minutes, what is its average speed in km/h?",
      "expect": {
        "answerIncludesAny": [
