{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codali orchestration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/model"
      }
    },
    "bindings": {
      "type": "object",
      "required": [
        "lead"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/binding"
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "capability-and-capacity"
        },
        "requiredBackends": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "strategy"
      ]
    },
    "effort": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "low": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxTotalTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": []
        },
        "medium": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxTotalTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": []
        },
        "high": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxTotalTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": []
        },
        "max": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 1
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxModelCalls": {
              "type": "integer",
              "minimum": 1
            },
            "maxTotalTokens": {
              "type": "integer",
              "minimum": 1
            },
            "maxOutputTokens": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": []
        }
      },
      "required": []
    },
    "taskControl": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWritingTasksPerWorktree": {
          "const": 1
        },
        "maxConcurrentHelpers": {
          "type": "integer",
          "minimum": 1
        },
        "helpers": {
          "const": "read-only-or-draft"
        },
        "repeatedFailureThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "repairAttemptsBeforeReplan": {
          "type": "integer",
          "minimum": 1
        },
        "checkpointOn": {
          "type": "array",
          "items": {
            "enum": [
              "task-transition",
              "before-compaction",
              "before-exit"
            ]
          }
        },
        "reviewPolicy": {
          "const": "risk-and-evidence"
        }
      },
      "required": [
        "maxWritingTasksPerWorktree",
        "maxConcurrentHelpers",
        "helpers",
        "repeatedFailureThreshold",
        "repairAttemptsBeforeReplan",
        "checkpointOn",
        "reviewPolicy"
      ]
    },
    "docdex": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binary": {
          "type": "string",
          "minLength": 1
        },
        "startupTimeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "routerBinding": {
          "type": "string",
          "minLength": 1
        },
        "answerBinding": {
          "type": "string",
          "minLength": 1
        },
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "routerResponseFormat": {
          "type": "string",
          "enum": ["json", "json_schema"]
        },
        "calculator": {
          "type": "boolean",
          "default": false
        },
        "answerReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "binding": { "type": "string", "minLength": 1 },
            "maxOutputTokens": { "type": "integer", "minimum": 1, "maximum": 4096 }
          }
        },
        "routerPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "answerPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16000
        },
        "maxInputChars": {
          "type": "integer",
          "minimum": 1
        },
        "historyChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1
        },
        "maxInspectionSteps": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "directories": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000]*\\S[^\\u0000]*$"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "providers",
    "models",
    "bindings"
  ],
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "mswarm",
            "openai-compatible"
          ]
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "catalogUrl": {
          "type": "string",
          "format": "uri"
        },
        "usageUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "adapter",
        "baseUrl"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "catalogId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "chat.completions",
              "embeddings",
              "images.generations",
              "audio.generations",
              "videos.generations"
            ]
          }
        },
        "backend": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "resourcePool": {
          "type": "string",
          "minLength": 1
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "supportsTools": {
          "type": "boolean"
        },
        "supportsStreaming": {
          "type": "boolean"
        },
        "embeddingDimensions": {
          "type": "integer",
          "minimum": 1
        },
        "reasoning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "low": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reasoning_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_budget": {
                  "type": "integer",
                  "minimum": 1
                },
                "enable_thinking": {
                  "type": "boolean"
                },
                "reasoning_budget_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": []
            },
            "medium": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reasoning_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_budget": {
                  "type": "integer",
                  "minimum": 1
                },
                "enable_thinking": {
                  "type": "boolean"
                },
                "reasoning_budget_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": []
            },
            "high": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reasoning_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_budget": {
                  "type": "integer",
                  "minimum": 1
                },
                "enable_thinking": {
                  "type": "boolean"
                },
                "reasoning_budget_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": []
            },
            "max": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reasoning_effort": {
                  "type": "string",
                  "minLength": 1
                },
                "reasoning_budget": {
                  "type": "integer",
                  "minimum": 1
                },
                "enable_thinking": {
                  "type": "boolean"
                },
                "reasoning_budget_tokens": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                }
              },
              "required": []
            }
          },
          "required": []
        },
        "embedding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queryPrefix",
            "documentPrefix",
            "normalization",
            "pooling"
          ],
          "properties": {
            "queryPrefix": {
              "type": "string",
              "maxLength": 256
            },
            "documentPrefix": {
              "type": "string",
              "maxLength": 256
            },
            "normalization": {
              "enum": [
                "none",
                "l2"
              ]
            },
            "pooling": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "required": [
        "provider",
        "catalogId",
        "revision",
        "operations",
        "contextWindow",
        "maxOutputTokens"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "useBinding": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "embeddingSpace": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "anyOf": [
        {
          "properties": {
            "enabled": {
              "const": false
            }
          },
          "required": ["enabled"]
        },
        {
          "required": [
            "candidates"
          ],
          "not": {
            "required": [
              "useBinding"
            ]
          }
        },
        {
          "required": [
            "useBinding"
          ],
          "not": {
            "required": [
              "candidates"
            ]
          }
        }
      ]
    }
  }
}
