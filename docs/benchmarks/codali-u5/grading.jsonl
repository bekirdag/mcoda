{"id": "u5-17", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": [], "expected": []}, {"input": ["a", "a", "b", "a"], "expected": [2, 1, 1]}, {"input": ["x"], "expected": [1]}, {"input": ["b", "b", "b"], "expected": [3]}], "reference": "export function solve(a){const r=[];for(let i=0;i<a.length;i++){if(i&&a[i]===a[i-1])r[r.length-1]++;else r.push(1);}return r;}"}
{"id": "u5-18", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": [], "expected": []}, {"input": [1, [2, 3], [], 4], "expected": [1, 2, 3, 4]}, {"input": [[0], [-2], 3], "expected": [0, -2, 3]}], "reference": "export function solve(a){return a.flat(1);}"}
{"id": "u5-19", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": [], "expected": null}, {"input": ["a", "b", "a", "c"], "expected": "b"}, {"input": ["x", "x"], "expected": null}, {"input": ["__proto__", "a", "a"], "expected": "__proto__"}], "reference": "export function solve(a){const m=new Map();for(const x of a)m.set(x,(m.get(x)||0)+1);return a.find(x=>m.get(x)===1)??null;}"}
{"id": "u5-20", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": [], "expected": []}, {"input": [3, -1, 3, 0, -1], "expected": [[-1, 2], [0, 1], [3, 2]]}, {"input": [10, 2, 10], "expected": [[2, 1], [10, 2]]}], "reference": "export function solve(a){const m=new Map();for(const x of a)m.set(x,(m.get(x)||0)+1);return [...m].sort((a,b)=>a[0]-b[0]);}"}
{"id": "u5-21", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": [], "expected": []}, {"input": [[], []], "expected": []}, {"input": [[1, 2, 3], [4, 5, 6]], "expected": [[1, 4], [2, 5], [3, 6]]}, {"input": [[8]], "expected": [[8]]}], "reference": "export function solve(a){return a.length?a[0].map((_,i)=>a.map(r=>r[i])):[];}"}
{"id": "u5-22", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": {"start": 2, "end": 9, "step": 3}, "expected": [2, 5, 8]}, {"input": {"start": 5, "end": 5, "step": 2}, "expected": []}, {"input": {"start": -4, "end": 2, "step": 2}, "expected": [-4, -2, 0]}], "reference": "export function solve({start,end,step}){const r=[];for(let x=start;x<end;x+=step)r.push(x);return r;}"}
{"id": "u5-23", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": "", "expected": true}, {"input": "(()())", "expected": true}, {"input": ")(", "expected": false}, {"input": "(()", "expected": false}, {"input": "())(", "expected": false}], "reference": "export function solve(s){let n=0;for(const c of s){n+=c===\"(\"?1:-1;if(n<0)return false;}return n===0;}"}
{"id": "u5-24", "kind": "code", "critical": false, "preserveInput": true, "distinctOutputFrom": [], "tests": [{"input": {"items": [], "k": 5}, "expected": []}, {"input": {"items": [1, 2, 3], "k": 1}, "expected": [3, 1, 2]}, {"input": {"items": [1, 2, 3], "k": 4}, "expected": [3, 1, 2]}, {"input": {"items": ["a"], "k": 100}, "expected": ["a"]}], "reference": "export function solve({items,k}){if(!items.length)return [];const n=k%items.length;return n?[...items.slice(-n),...items.slice(0,-n)]:[...items];}"}
